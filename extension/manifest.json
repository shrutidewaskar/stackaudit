{
  "manifest_version": 3,
  "name": "StackAudit Browser Intelligence",
  "version": "1.0.0",
  "description": "Privacy-first metadata browser activity extension for StackAudit telemetry integration.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.chatgpt.com/*",
    "https://*.claude.ai/*",
    "https://*.gemini.google.com/*",
    "https://*.perplexity.ai/*",
    "https://*.copilot.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chatgpt.com/*",
        "https://*.claude.ai/*",
        "https://*.gemini.google.com/*",
        "https://*.perplexity.ai/*",
        "https://*.copilot.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StackAudit status"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
